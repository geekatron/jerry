# CODEOWNERS — Require review for security-sensitive files
#
# GitHub evaluates CODEOWNERS top-to-bottom; last matching pattern wins.
# See: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# CI/CD pipeline files — changes to workflows, Dependabot, or pre-commit
# require review from a maintainer with security context.
.github/workflows/     @geekatron
.github/dependabot.yml @geekatron
.github/CODEOWNERS     @geekatron
.pre-commit-config.yaml @geekatron
# release.yml runs this script with the release tokens, so a change to it needs the same review.
scripts/release/            @geekatron
tests/unit/scripts/release/ @geekatron

# Governance and rule files — changes to framework constraints
.context/rules/        @geekatron
docs/governance/       @geekatron

# Composite action and accept-list files — changes require maintainer review
# to prevent supply-chain attacks via the action script or CVE suppression abuse.
.github/actions/   @geekatron
.github/security/  @geekatron

# Scripts, configuration and dependency files that a job with write permissions
# runs or reads as code.
/scripts/security/        @geekatron
/scripts/sync_versions.py @geekatron
/pyproject.toml           @geekatron
/uv.lock                  @geekatron
/pytest.ini               @geekatron
/mkdocs.yml               @geekatron
/overrides/               @geekatron
